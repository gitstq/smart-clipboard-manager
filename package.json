{
  "name": "smart-clipboard-manager",
  "version": "1.0.0",
  "description": "🚀 A powerful cross-platform clipboard manager with history, search, and smart categorization",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:all": "electron-builder -mwl",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "productivity",
    "electron",
    "cross-platform",
    "history",
    "search",
    "typescript"
  ],
  "author": "Smart Clipboard Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitstq/smart-clipboard-manager.git"
  },
  "bugs": {
    "url": "https://github.com/gitstq/smart-clipboard-manager/issues"
  },
  "homepage": "https://github.com/gitstq/smart-clipboard-manager#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.smartclipboard.manager",
    "productName": "Smart Clipboard Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    }
  }
}
